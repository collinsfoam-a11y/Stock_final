# ============================================================================
# Stock Verify Application - Environment Configuration (Development)
# ============================================================================
# SECURITY WARNING: Never commit actual .env files to version control!
# This is a template file. Copy to .env and fill in your actual values.
# ============================================================================

# ----------------------------------------------------------------------------
# MongoDB Configuration (REQUIRED)
# ----------------------------------------------------------------------------
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=stock_verification

# ----------------------------------------------------------------------------
# JWT Configuration (REQUIRED - CRITICAL SECURITY)
# ----------------------------------------------------------------------------
# IMPORTANT: Generate secure secrets using: python backend/utils/secret_generator.py
# These MUST be set via environment variables in production
# Minimum 32 characters, use cryptographically secure random strings
JWT_SECRET=GENERATE_SECURE_SECRET_HERE_MIN_32_CHARS
JWT_REFRESH_SECRET=GENERATE_DIFFERENT_SECURE_SECRET_HERE_MIN_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ----------------------------------------------------------------------------
# SQL Server Configuration (Optional - for ERP integration)
# ----------------------------------------------------------------------------
# Leave empty if not using SQL Server ERP integration
SQL_SERVER_HOST=
SQL_SERVER_PORT=1433
SQL_SERVER_DATABASE=
SQL_SERVER_USER=
SQL_SERVER_PASSWORD=

# Optional: Performance tuning
# SYNC_BATCH_SIZE=1000
# PARALLEL_SYNC_WORKERS=4

# ----------------------------------------------------------------------------
# Redis Configuration (Optional - recommended for production)
# ----------------------------------------------------------------------------
# Uncomment and configure if using Redis for caching
# REDIS_URL=redis://localhost:6379/0
# REDIS_PASSWORD=

# ----------------------------------------------------------------------------
# Application Settings
# ----------------------------------------------------------------------------
LOG_LEVEL=INFO
ENVIRONMENT=development
APP_NAME=Stock Count API
APP_VERSION=2.0.0
AUTO_SEED_DEFAULT_USERS=false
AUTO_SEED_MOCK_ERP_DATA=false

# ----------------------------------------------------------------------------
# Server Configuration
# ----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8001
WORKERS=1
PI_SERVER_URL=http://localhost:8045/v1
# Optional. Leave blank for local unauthenticated pi-server sidecar mode.
PI_SERVER_API_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
ENABLE_LAN_ENFORCEMENT=false
AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_DOMAIN=

# Projection read cutover controls. Keep read flags off until parity,
# freshness, lag, stability-window, and staging gates pass.
V3_PROJECTION_DASHBOARD_READS=true
V3_PROJECTION_REPORT_READS=true
SHADOW_READ_ENABLED=false
SHADOW_READ_SAMPLE_RATE=0.10
SHADOW_READ_TIMEOUT_SECONDS=2.0
SHADOW_READ_VARIANCE_ABS_TOLERANCE=1.0
SHADOW_READ_VARIANCE_REL_TOLERANCE=0.005
SHADOW_READ_FULL_DIFF_LOGGING=false
SHADOW_AUTO_DECISION_ENABLED=true
SHADOW_DECISION_WINDOW_SECONDS=7200
SHADOW_MIN_STABLE_WINDOW_MINUTES=120
SHADOW_EVAL_INTERVAL_SECONDS=300
SHADOW_MIN_SAMPLES=500
SHADOW_MIN_SAMPLES_PER_ENDPOINT=50
SHADOW_RECENT_WINDOW_MINUTES=15
SHADOW_MAX_CLOCK_SKEW_SECONDS=5
SHADOW_MONITOR_INTERVAL_SECONDS=600
SHADOW_MISMATCH_THRESHOLD=0.001
SHADOW_TIMEOUT_THRESHOLD=0.01
SHADOW_ERROR_THRESHOLD=0.0
ROLLOUT_STAGE=0
ROLLOUT_COOLDOWN_MINUTES=30
ROLLOUT_MODE=false
PROJECTION_SNAPSHOT_MODE=false
SHADOW_ALERT_DEDUPE_SECONDS=600
AUTO_ROLLBACK_ENABLED=true
AUTO_ROLLBACK_MISMATCH_RATE=0.005
AUTO_ROLLBACK_TIMEOUT_RATE=0.01
DEPLOYMENT_DECISION_STORE_PATH=.agent/reports/deployment-decisions.jsonl
DEPLOYMENT_DECISION_HISTORY_LIMIT=500
DEPLOYMENT_DECISION_MAX_BYTES=50000000
DEPLOYMENT_DECISION_RETENTION_DAYS=14
PROJECTION_READINESS_COLLECTION=projection_readiness
PROJECTION_READINESS_DOCUMENT_ID=current
PROJECTION_GATE_TTL_SECONDS=30
PROJECTION_GATE_RETRY_AFTER_SECONDS=30
PROJECTION_STABILITY_WINDOW_SECONDS=60
PROJECTION_MAX_LAG_SECONDS=5
PROJECTION_FRESHNESS_SECONDS=300
PROJECTION_DRIFT_COOLDOWN_SECONDS=300
PROJECTION_ALERT_READINESS_FALSE_SECONDS=60
PROJECTION_ALERT_SYNC_FAILURE_RATE=0.10
PROJECTION_VALIDATION_FRESHNESS_RETRIES=3
PROJECTION_VALIDATION_FRESHNESS_RETRY_DELAY_SECONDS=0.5
SESSION_CLIENT_ID_TTL_HOURS=48

# ----------------------------------------------------------------------------
# Cache Configuration
# ----------------------------------------------------------------------------
CACHE_TTL=3600

# ----------------------------------------------------------------------------
# Rate Limiting
# ----------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=20
MAX_CONCURRENT=50

# ----------------------------------------------------------------------------
# Connection Pool
# ----------------------------------------------------------------------------
USE_CONNECTION_POOL=true
POOL_SIZE=10
MAX_OVERFLOW=5

# ----------------------------------------------------------------------------
# Sync Services
# ----------------------------------------------------------------------------
ERP_SYNC_ENABLED=false
CHANGE_DETECTION_SYNC_ENABLED=true
CHANGE_DETECTION_INTERVAL=300

# ----------------------------------------------------------------------------
# CORS Configuration (Development)
# ----------------------------------------------------------------------------
# Add your frontend URLs here (comma-separated)
# Example: http://192.168.0.103:8081,exp://192.168.0.103:8081
CORS_DEV_ORIGINS=http://localhost:8081,exp://localhost:8081
