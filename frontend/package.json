{
  "name": "frontend",
  "version": "2.1.0",
  "private": true,
  "main": "index.js",
  "overrides": {
    "@tootallnate/once": "^3.0.1"
  },
  "engines": {
    "node": ">=20.19.4 <26.0.0"
  },
  "scripts": {
    "doctor:node": "node ./scripts/check-node-version.cjs",
    "doctor:expo": "npx expo-doctor",
    "postinstall": "node -e \"if (process.env.SKIP_POSTINSTALL === 'true') { process.exit(0); }\" && patch-package",
    "prestart": "npm run doctor:node && npm run update-ip --silent",
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "start:offline": "expo start --offline",
    "start:clear": "expo start --clear",
    "reset-project": "node ./scripts/reset-project.js",
    "update-ip": "node ./scripts/update-ip.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:clear": "expo start --web --clear",
    "lint": "expo lint -- --no-error-on-unmatched-pattern",
    "lint:fix": "expo lint -- --fix --no-error-on-unmatched-pattern",
    "test": "node ./scripts/run-jest.cjs",
    "test:watch": "node ./scripts/run-jest.cjs --watch",
    "test:coverage": "node ./scripts/run-jest.cjs --coverage",
    "e2e:recount-smoke": "E2E_BASE_URL=http://127.0.0.1:8081 E2E_WEB_PORT=8081 E2E_REUSE_EXISTING_SERVER=true playwright test e2e/recount-assignment-ui.spec.ts --project='Desktop Chrome' --project='Mobile Chrome'",
    "e2e:recount-smoke:desktop": "E2E_BASE_URL=http://127.0.0.1:8081 E2E_WEB_PORT=8081 E2E_REUSE_EXISTING_SERVER=true playwright test e2e/recount-assignment-ui.spec.ts --project='Desktop Chrome'",
    "e2e:recount-smoke:mobile": "E2E_BASE_URL=http://127.0.0.1:8081 E2E_WEB_PORT=8081 E2E_REUSE_EXISTING_SERVER=true playwright test e2e/recount-assignment-ui.spec.ts --project='Mobile Chrome'",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "build:web": "expo export --clear -p web",
    "bundle:web:report": "node ./scripts/report-web-bundle.cjs",
    "build:web:analyze": "npm run build:web && npm run bundle:web:report",
    "build:android": "eas build -p android",
    "build:ios": "eas build -p ios",
    "ci": "npm run lint && npm run typecheck && npm run test",
    "ci:parallel": "npm-run-all --parallel lint typecheck test",
    "preflight": "npm-run-all doctor:expo lint typecheck test build:web:analyze",
    "validate": "npm-run-all --parallel lint typecheck && npm run test",
    "clean": "rm -rf node_modules/.cache .expo dist",
    "clean:all": "rm -rf node_modules .expo dist && npm install",
    "deps:check": "npx npm-check -u",
    "deps:outdated": "npm outdated",
    "storybook:dev": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "prepare": "cd .. && husky || true"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-native-community/netinfo": "11.5.2",
    "@react-native-community/slider": "5.1.2",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.100.5",
    "axios": "^1.15.2",
    "expo": "~55.0.18",
    "expo-background-task": "~55.0.17",
    "expo-blur": "~55.0.14",
    "expo-brightness": "~55.0.13",
    "expo-camera": "~55.0.16",
    "expo-clipboard": "~55.0.13",
    "expo-constants": "~55.0.15",
    "expo-crypto": "~55.0.14",
    "expo-file-system": "~55.0.17",
    "expo-font": "~55.0.6",
    "expo-haptics": "~55.0.14",
    "expo-image": "~55.0.9",
    "expo-keep-awake": "~55.0.6",
    "expo-linear-gradient": "~55.0.13",
    "expo-linking": "~55.0.14",
    "expo-local-authentication": "~55.0.13",
    "expo-notifications": "~55.0.21",
    "expo-router": "~55.0.13",
    "expo-secure-store": "~55.0.13",
    "expo-sharing": "~55.0.18",
    "expo-speech": "~55.0.13",
    "expo-splash-screen": "~55.0.19",
    "expo-sqlite": "~55.0.15",
    "expo-status-bar": "~55.0.5",
    "expo-system-ui": "~55.0.16",
    "expo-task-manager": "~55.0.15",
    "lottie-react-native": "^7.1.0",
    "metro-resolver": "^0.84.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-error-boundary": "^6.1.0",
    "react-hook-form": "^7.74.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.4",
    "use-debounce": "^10.1.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/runtime": "^7.26.0",
    "@expo/metro-runtime": "~55.0.10",
    "@playwright/test": "^1.57.0",
    "@storybook/addon-essentials": "^8.6.15",
    "@storybook/react": "^8.6.15",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/react-native": "^13.3.3",
    "@tootallnate/once": "^3.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.1.0",
    "@types/react": "~19.2.10",
    "@types/react-dom": "~19.2.0",
    "babel-jest": "~29.7.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-transform-import-meta": "^2.3.3",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-preset-expo": "^55.0.18",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~55.0.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-environment-jsdom": "^30.3.0",
    "jest-expo": "~55.0.16",
    "lint-staged": "^16.2.7",
    "npm-run-all2": "^7.0.2",
    "patch-package": "^8.0.1",
    "playwright": "^1.57.0",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^3.7.4",
    "storybook": "^8.6.15",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
